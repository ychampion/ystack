# Settings for sweep.sh. Copy to security-sweep.env next to sweep.sh and edit.
# Every value is optional; the defaults are shown.

# apply = install restart-free security updates; dry-run = change nothing.
#SWEEP_MODE=apply

# Short name used in reports and inbox entries.
#SWEEP_HOST_LABEL=$(hostname -s)

# Where to look for git repositories (globs allowed) and which folder names to skip.
#SWEEP_REPO_ROOTS="/root /home/* /srv"
#SWEEP_REPO_PRUNE="node_modules .cache vendor .npm .bun .cargo .rustup .nvm .pyenv .local snap .Trash"
# Folder names osv-scanner skips inside each repo (test fixtures hold fake lockfiles).
#SWEEP_OSV_EXCLUDE="node_modules vendor .cache fixtures testdata"

# Decision-inbox folders to write alerts to (space separated); empty = no inbox entries.
#SWEEP_INBOX_DIRS="/root/.claude/decision-inbox"

# RAM-backed scratch for the trivy DB (about 1.6 GB, plus 1.5 GB for the Java DB) and image
# exports, deleted after every run so nothing large ever lands on disk.
#SWEEP_SCRATCH_BASE=/dev/shm
# Skip image and host scans when less memory than this is available.
#SWEEP_MIN_MEM_MB=8192
# Java DB: 1 = always, 0 = never, auto = only with SWEEP_MIN_MEM_MB + 4 GB available.
#SWEEP_JAVA_DB=auto

# Do not install updates when / has less free space than this.
#SWEEP_MIN_FREE_MB=2048

# Extra package-name regexes never to update automatically (space separated).
#SWEEP_HOLD_EXTRA="^nginx$ ^postgresql-"
# Packages always held (container runtime); override only if you know why.
#SWEEP_HOLD_ALWAYS="^docker-ce$ ^docker-ce-cli$ ^docker-ce-rootless-extras$ ^docker\.io$ ^containerd$ ^containerd\.io$ ^runc$"

# Skip whole stages: os, repos, docker, globals (comma separated).
#SWEEP_SKIP=

# How many raw-result archives to keep in runs/.
#SWEEP_KEEP_RUNS=4

# Scanner versions for install-tools.sh.
#TRIVY_VERSION=0.76.1
#OSV_SCANNER_VERSION=2.7.0
