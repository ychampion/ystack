{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(exec|shell_command)$",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/push-guard.mjs\" --host devin", "timeout": 30 },
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/package-bouncer.mjs\" --host devin", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write|edit|apply_patch|notebook_edit|exec|shell_command)$",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/verify.mjs\" --host devin", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/verify.mjs\" --host devin", "timeout": 30 }]
      }
    ]
  }
}
